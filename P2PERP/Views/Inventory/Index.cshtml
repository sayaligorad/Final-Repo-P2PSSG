                // Reset all footer cells first to ensure clean state
                api.columns().every(function () {
                    $(this.footer()).html("").removeClass("grand-total-label grand-total-value");
                });

                // Calculate and set Total Value based on SELECTION
                api.columns().every(function (index) {
