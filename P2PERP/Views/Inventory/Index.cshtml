        var btnEl = document.getElementById('dateFilterBtn');
        if (btnEl) {
            btnEl.addEventListener('click', function (e) {
                if (isDragging) {
                    e.preventDefault();
                    e.stopPropagation();
                    e.stopImmediatePropagation();
                    console.log("Click blocked due to drag");
                }
            }, true); // Capture phase is key
        }

        $btn.draggable({
            containment: "window",
            scroll: false,
            start: function () {
                isDragging = true;
                $(this).css('transition', 'none'); // Disable transition during drag for smoothness
            },
            stop: function () {
                // Keep isDragging true for a moment to block the click
                setTimeout(() => {
                    isDragging = false;
                    $(this).css('transition', 'transform 0.2s, box-shadow 0.2s'); // Re-enable transition
                }, 100);
            }
        });
    });

