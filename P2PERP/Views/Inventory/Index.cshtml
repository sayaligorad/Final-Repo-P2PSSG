                    </div>
                    <i class="bi bi-wallet2 card-bg-icon"></i>
                </div>
            </div>

            <!-- High Consumption Items Value -->
            <div class="col-sm-6 col-lg-3 animate-enter" style="animation-delay: 0.2s;"
                onclick="openModalWithData('HighConsumption', 'MostStock')">
                <div class="dashboard-card card-success cursor-pointer">
                    <div class="card-content">
                        <div class="card-icon-wrapper">
                            <i class="bi bi-lightning-charge-fill"></i>
                        </div>
                        <h5 id="highConsumptionValue" class="card-value">0</h5>
                        <p id="lblHighConsumptionValue" class="card-label">Current High Consumption</p>
                    </div>
                    <i class="bi bi-lightning-charge-fill card-bg-icon"></i>
                </div>
            </div>

            <!-- Non Moving Items Value -->
            <div class="col-sm-6 col-lg-3 animate-enter" style="animation-delay: 0.3s;"
                onclick="openModalWithData('NonMoving', 'DeadStock')">
                <div class="dashboard-card card-danger cursor-pointer">
                    <div class="card-content">
                        <div class="card-icon-wrapper">
                            <i class="bi bi-archive-fill"></i>
                        </div>
                        <h5 id="nonMovingValue" class="card-value">0</h5>
                        <p id="lblNonMovingValue" class="card-label">Current Dead Stocks</p>
                    </div>
                    <i class="bi bi-archive-fill card-bg-icon"></i>
                </div>
                <div class="bottom-border bg-info"></div>
            </div>

            <!-- Material Issued Value -->
            <div class="col-sm-6 col-lg-3 animate-enter" style="animation-delay: 0.4s;"
                onclick="openModalWithData('IssuedValue', '')">
                <div class="dashboard-card card-warning cursor-pointer">
                    <div class="card-content">
                        <div class="card-icon-wrapper">
                            <i class="bi bi-box-arrow-right"></i>
                        </div>
                        <h5 id="issuedValue" class="card-value">0</h5>
                        <p id="lblIssuedValue" class="card-label">Current Issued Value</p>
                    </div>
                    <i class="bi bi-box-arrow-right card-bg-icon"></i>
                </div>
            </div>

        </div>
    </div>

    <!-- ====== Charts Section ====== -->
    <div class="row g-4">

        <div class="col-lg-6 animate-enter" style="animation-delay: 0.5s;">
            <div class="chart-panel">
                <div class="chart-header">
                    <div class="chart-title"><i class="bi bi-bar-chart-fill text-primary"></i> Inventory Stocks</div>
                </div>
                <div id="inventoryStocks" class="chart-container" style="height: 350px;"></div>
            </div>
        </div>

        <div class="col-lg-6 animate-enter" style="animation-delay: 0.6s;">
            <div class="chart-panel">
                <div class="chart-header">
                    <div class="chart-title"><i class="bi bi-pie-chart-fill text-warning"></i> Inventory Breakdown</div>
                </div>
                <div id="inventoryBreakdown" class="chart-container" style="height: 350px;"></div>
            </div>
        </div>

        <div class="col-lg-12 animate-enter" style="animation-delay: 0.7s;">
            <div class="chart-panel">
                <div class="chart-header">
                    <div class="chart-title"><i class="bi bi-exclamation-triangle-fill text-danger"></i> Issue in House
                    </div>
                </div>
                <div id="issueHouse" class="chart-container" style="height: 350px;"></div>
            </div>
        </div>
    </div>
    <!-- Floating Date Filter Button -->
    <div id="dateFilterBtn" class="fab-btn" data-bs-toggle="tooltip" title="Filter Date">
        <i class="bi bi-calendar4-week"></i>
    </div>
</div>

