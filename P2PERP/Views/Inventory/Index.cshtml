<script>
    // Global Page-Scoped Selection Logic
    $(document).on('change', '#selectAll, #select-all', function (e) {
        let isChecked = $(this).is(':checked');
        let $table = $(this).closest('table');

        // Find all checkboxes in the CURRENT PAGE of the tbody
        if ($.fn.DataTable.isDataTable($table)) {
            let api = $table.DataTable();
            api.rows({ page: 'current' }).nodes().to$().find('input[type="checkbox"]').prop('checked', isChecked).trigger('change');
        } else {
            $table.find('tbody input[type="checkbox"]').prop('checked', isChecked).trigger('change');
        }
    });
</script>