@{
    ViewBag.Title = "Inventory Dashboard";
}


<style>
    /* ===== Inventory-Specific Layout Refinements ===== */
    /* Hiding Bulky Titles from Partial Views for Sleek Dashboard Look */
    #mainTitle,
    #subTitle,
    .text-center.mb-3 h3.text-primary {
        display: none !important;
    }

    /* Selection Checkboxes (Page Specific Overrides if any) */
    input[type="checkbox"] {
        accent-color: #8b5cf6;
    }

    /* Tab Styling (Inventory Pills) */
    .nav-pills .nav-link {
        border-radius: 8px !important;
        padding: 10px 24px !important;
        margin-right: 15px;
        font-weight: 600 !important;
        font-size: 0.9rem !important;
        transition: all 0.3s ease !important;
        background-color: #f3f0ff !important;
        color: #8b5cf6 !important;
        border: none !important;
    }

    .nav-pills .nav-link.active {
        background-color: #8b5cf6 !important;
        color: #ffffff !important;
        box-shadow: 0 4px 12px rgba(139, 92, 246, 0.2);
    }

    .nav-pills .nav-link:hover:not(.active) {
        background-color: #e5e0ff !important;
    }

    /* ===== Premium Inventory Global Harmonization Styles ===== */
    :root {
        --theme-purple: #8b5cf6;
        /* Vibrant Purple */
        --theme-purple-light: #f3f0ff;
        --theme-dark: #1f2937;
        /* Consistent Black/Dark Gray */
        --theme-green: #4caf50;
        /* Specific Green from image */
        --border-radius-sm: 8px;
        --border-radius-lg: 12px;
    }

    /* 1. Global Table Headers - Ultra High Specificity Local Override */
    table thead th,
    .dataTable thead th,
    .table thead th,
    table.dataTable thead th,
    #chartDataTable thead th {
        background-color: #1f2937 !important;
        background-image: none !important;
        /* Remove DataTables sort icons background if any */
        color: white !important;
        text-transform: uppercase !important;
        font-size: 0.75rem !important;
        font-weight: 700 !important;
        letter-spacing: 0.5px;
        padding: 8px 10px !important;
        border: 1px solid #374151 !important;
        text-align: center !important;
        vertical-align: middle !important;
    }

    /* 3. Global Action Buttons (Edit/View) */
    .btn-sm.btnedit,
    .btnedit,
    .btn-secondary.btn-sm,
    [title="Edit Item"],
    .btn-edit {
        background-color: #9ca3af !important;
        /* Specific Slate/Grey */
        border: none !important;
        border-radius: var(--border-radius-sm) !important;
        color: white !important;
        width: 32px;
        height: 32px;
        padding: 0 !important;
        display: inline-flex !important;
        align-items: center;
        justify-content: center;
        transition: all 0.2s;
    }

    .btn-sm.btnview,
    .btnview,
    .btn-primary.btn-sm,
    [title="View Item"],
    .btn-view,
    .btn-view-plan {
        background-color: var(--theme-purple) !important;
        border: none !important;
        border-radius: var(--border-radius-sm) !important;
        color: white !important;
        width: 32px;
        height: 32px;
        padding: 0 !important;
        display: inline-flex !important;
        align-items: center;
        justify-content: center;
        transition: all 0.2s;
    }

    .btnedit:hover,
    .btnview:hover {
        transform: scale(1.1);
        filter: brightness(1.1);
    }

    /* 4. The Famous Green "Create" Button */
    .btn-success,
    #createitem,
    #subitem,
    .btn-add {
        background-color: var(--theme-green) !important;
        border: none !important;
        border-radius: 20px !important;
        padding: 8px 20px !important;
        font-weight: 600 !important;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
    }

    /* 5. Export Button Squares */
    .dt-buttons .btn,
    .dt-button {
        background: #f3f4f6 !important;
        border: 1px solid #e5e7eb !important;
        border-radius: 10px !important;
        width: 42px !important;
        height: 42px !important;
        margin-right: 8px !important;
        display: inline-flex !important;
        align-items: center;
        justify-content: center;
        box-shadow: none !important;
    }

    /* 6. Professional Search Bar */
    .dataTables_filter label {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        font-weight: 500;
        color: #4b5563;
    }

    .dataTables_filter input {
        border: 1px solid #d1d5db !important;
        border-radius: 20px !important;
        /* Pill shape like reference */
        padding: 6px 15px !important;
        width: 250px !important;
        outline: none;
        transition: border 0.3s;
        font-size: 0.85rem;
    }

    .dataTables_filter input:focus {
        border-color: var(--theme-purple) !important;
        box-shadow: 0 0 0 2px var(--theme-purple-light);
    }

    /* 6.1 Action Buttons + Search Alignment */
    .table-controls {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 20px;
        flex-wrap: nowrap;
    }

    .dt-buttons {
        display: flex;
        gap: 8px;
        margin-bottom: 0 !important;
    }

    .dataTables_filter {
        margin-top: 0 !important;
    }

    /* 7. Date Range Filter Harmony */
    .input-group-text.bg-primary {
        background-color: var(--theme-purple) !important;
        border: none !important;
        border-radius: 8px 0 0 8px !important;
    }

    #reportrange,
    #itemdatefilter {
        border: 1px solid #d1d5db !important;
        border-radius: 0 8px 8px 0 !important;
        padding: 8px 15px !important;
    }

    /* 8. Modern Table Body */
    table tbody td,
    .dataTable tbody td {
        padding: 12px 10px !important;
        border-bottom: 1px solid #f3f4f6 !important;
        border-right: 1px solid #f3f4f6 !important;
        color: #374151;
        font-size: 0.85rem;
    }

    table tbody tr:hover {
        background-color: #f9fafb !important;
    }

    /* Dark Footer Bar (Grand Total) */
    .dataTable tfoot tr {
        background-color: #1f2937 !important;
        color: white !important;
    }

    .dataTable tfoot th {
        border: none !important;
        padding: 10px 15px !important;
        color: white !important;
        font-weight: 700 !important;
    }

    .grand-total-label {
        text-align: right !important;
        text-transform: uppercase;
        font-size: 0.85rem;
    }

    .grand-total-value {
        text-align: center !important;
        font-size: 1rem;
    }

    /* Pagination Styling - Exact Circle Match */
    .dataTables_paginate .paginate_button {
        background: #f0f0f0 !important;
        border-radius: 50% !important;
        width: 40px !important;
        height: 40px !important;
        line-height: 40px !important;
        padding: 0 !important;
        margin: 0 6px !important;
        border: none !important;
        display: inline-flex !important;
        align-items: center;
        justify-content: center;
        color: #4a5568 !important;
        font-weight: 500 !important;
        transition: all 0.2s;
    }

    .dataTables_paginate .paginate_button.current {
        background: #8b5cf6 !important;
        color: white !important;
        box-shadow: 0 4px 10px rgba(139, 92, 246, 0.3);
    }

    .dataTables_paginate .paginate_button:hover:not(.current) {
        background: #e2e8f0 !important;
    }

    .dataTables_info {
        color: #718096 !important;
        font-weight: 500;
        margin-top: 15px;
    }

    /* Modal Styling - Premium Match */
    .modal-content {
        border-radius: 20px !important;
        border: none !important;
        overflow: hidden;
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
    }

    .modal-header {
        background: #8b5cf6 !important;
        padding: 12px 25px !important;
        border-bottom: none !important;
        display: flex !important;
        justify-content: center !important;
        align-items: center !important;
        position: relative;
    }

    .modal-title {
        color: white !important;
        font-weight: 600 !important;
        font-size: 1.15rem;
        letter-spacing: 0.5px;
        text-align: center;
        flex-grow: 1;
    }

    .btn-close-custom {
        position: absolute;
        right: 15px;
        background: rgba(255, 255, 255, 0.2);
        border: none;
        color: white;
        width: 28px;
        height: 28px;
        border-radius: 6px;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: background 0.2s;
    }

    .btn-close-custom:hover {
        background: rgba(255, 255, 255, 0.3);
    }

    /* Table Footer - Dark Grand Total */
    #chartDataTable tfoot tr {
        background-color: #1f2937 !important;
        color: white !important;
    }

    #chartDataTable tfoot th {
        border: none !important;
        padding: 8px 10px !important;
        color: white !important;
        font-weight: 700 !important;
        font-size: 0.85rem;
    }
</style>

<div class="container-xxl flex-grow-1 container-p-y">


