<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>GRN Dashboard</title>

    <style>
        #reqTable th,
        #reqTable td {
            text-align: center;
            vertical-align: middle;
        }

        #ListTable th,
        #ListTable td {
            text-align: center;
            vertical-align: middle;
        }

        /* Chart Cards — Soft Materio Look */
        .chart-card {
            background: #ffffff;
            border-radius: 1rem !important;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
            transition: all 0.3s ease-in-out;
        }

            .chart-card:hover {
                transform: translateY(-3px);
                box-shadow: 0 10px 25px rgba(0, 0, 0, 0.08);
            }

        /* Highcharts Light Theme */
        .highcharts-background {
            fill: #ffffff !important;
        }

        .highcharts-title {
            fill: #333 !important;
            font-weight: 600;
        }

        .highcharts-axis-labels text {
            fill: #666 !important;
            font-size: 12px !important;
            font-weight: 500;
        }

        .highcharts-grid-line {
            stroke: rgba(200, 200, 200, 0.2) !important;
        }

        .highcharts-tooltip-box {
            fill: #fff !important;
            stroke: #ddd !important;
            filter: drop-shadow(0px 3px 5px rgba(0, 0, 0, 0.05));
        }


        /* Line chart smooth curve */
        .highcharts-series path {
            stroke-width: 3 !important;
            filter: drop-shadow(0 2px 6px rgba(0, 0, 0, 0.05));
        }

        /* Hover animation for cards */
        .hover-shadow {
            transition: all 0.3s ease-in-out;
        }

            .hover-shadow:hover {
                transform: translateY(-5px);
                box-shadow: 0 10px 25px rgba(0,0,0,0.1) !important;
            }

        /* Card Border Shadow Variants */
        .card-border-shadow-primary {
            border-left: 4px solid #4e73df !important;
        }

        .card-border-shadow-success {
            border-left: 4px solid #1cc88a !important;
        }

        .card-border-shadow-warning {
            border-left: 4px solid #f6c23e !important;
        }

        .card-border-shadow-info {
            border-left: 4px solid #36b9cc !important;
        }

        /* Bottom Border Animation */
        .bottom-border {
            position: absolute;
            bottom: 0;
            left: 0;
            width: 0;
            height: 3px;
            transition: width 0.3s ease-in-out;
        }

        .card:hover .bottom-border {
            width: 100%;
        }

        /* Avatar Styles */
        .avatar {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 48px;
            height: 48px;
        }

        .avatar-initial {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 100%;
            height: 100%;
        }

        /* Background Label Colors */
        .bg-label-primary {
            background-color: rgba(78, 115, 223, 0.1) !important;
            color: #4e73df !important;
        }

        .bg-label-success {
            background-color: rgba(28, 200, 138, 0.1) !important;
            color: #1cc88a !important;
        }

        .bg-label-warning {
            background-color: rgba(246, 194, 62, 0.1) !important;
            color: #f6c23e !important;
        }

        .bg-label-info {
            background-color: rgba(54, 185, 204, 0.1) !important;
            color: #36b9cc !important;
        }

        /* Text Colors */
        .text-primary {
            color: #4e73df !important;
        }

        .text-success {
            color: #1cc88a !important;
        }

        .text-warning {
            color: #f6c23e !important;
        }

        .text-info {
            color: #36b9cc !important;
        }

        /* Spacing adjustments */
        .card-body {
            padding: 1.5rem;
        }

        /* Floating button improvements */
        #dateFilterBtn {
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.2);
            transition: all 0.3s ease;
        }

            #dateFilterBtn:hover {
                transform: scale(1.1);
                box-shadow: 0 6px 15px rgba(0, 0, 0, 0.3);
            }

        /* Table improvements */
        .table-card {
            border: none;
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        }

            .table-card .card-header {
                background: linear-gradient(135deg, #0d6efd 0%, #0a58ca 100%);
                color: white;
                border-radius: 12px 12px 0 0 !important;
                padding: 1rem 1.5rem;
                border: none;
            }

        button.dt-button.processing,
        div.dt-button.processing {
            pointer-events: auto !important;
            opacity: 1 !important;
            background: none !important;
        }

            button.dt-button.processing:after {
                content: none !important;
            }

        /* Ripple effect for floating button */
        .ripple {
            position: relative;
            overflow: hidden;
        }

            .ripple:after {
                content: "";
                display: block;
                position: absolute;
                width: 100%;
                height: 100%;
                top: 0;
                left: 0;
                pointer-events: none;
                background-image: radial-gradient(circle, #fff 10%, transparent 10.01%);
                background-repeat: no-repeat;
                background-position: 50%;
                transform: scale(10, 10);
                opacity: 0;
                transition: transform .5s, opacity 1s;
            }

            .ripple:active:after {
                transform: scale(0, 0);
                opacity: .2;
                transition: 0s;
            }

        /* Chart header styling */
        .chart-header {
            color: white !important;
            border-radius: 12px 12px 0 0 !important;
            padding: 1rem 1.5rem;
            border: none;
        }

            .chart-header h5,
            .chart-header .mb-0 {
                color: white !important;
            }

            .chart-header .badge {
                color: #f8f9fa !important;
                background-color: rgba(255, 255, 255, 0.2) !important;
            }

        .chart-body {
            padding: 1.5rem;
            background-color: #f8f9fa;
        }

         Modal date picker styling 
        .modal-date-picker-container {
            padding: 0.75rem 1.5rem !important;
            background-color: #f8f9fa;
            border-bottom: 1px solid #dee2e6;
        }
    </style>
</head>
<body>
    <div class="container-fluid py-4 main-content">
        <!-- FLOATING DATE FILTER BUTTON -->
        <button id="dateFilterBtn"
                class="btn btn-primary btn-lg rounded-circle shadow-lg position-fixed d-flex align-items-center justify-content-center ripple"
                style="top: 90px; right: 20px; width: 65px; height: 65px; z-index: 1050;">
            <i class="bi bi-calendar-date fs-3"></i>
        </button>

        <!-- KPI CARDS SECTION -->
        <div class="row g-6 mb-4">
            <!-- Total GRNs Card -->
            <div class="col-sm-6 col-lg-4">
                <div id="TotalCountCard" class="card card-border-shadow-primary h-100 border-0 position-relative overflow-hidden hover-shadow" style="cursor: pointer;">
                    <div class="card-body">
                        <div class="d-flex align-items-center mb-2">
                            <div class="avatar me-4">
                                <span class="avatar-initial rounded bg-label-primary">
                                    <i class="bi bi-clipboard-data fs-4"></i>
                                </span>
                            </div>
                            <h4 class="mb-0 fw-bold text-primary" id="TotalGRNCount">0</h4>
                        </div>
                        <h6 class="mb-0 fw-normal">Total GRNs</h6>
                        <p class="mb-0">
                            <small class="text-body-secondary">All time GRN count</small>
                        </p>
                    </div>
                    <div class="bottom-border bg-primary"></div>
                </div>
            </div>

            <!-- Total GRN Items Card -->
            @*<div class="col-sm-6 col-lg-3">
                <div id="GRNItemsCountCard" class="card card-border-shadow-success h-100 border-0 position-relative overflow-hidden hover-shadow" style="cursor: pointer;">
                    <div class="card-body">
                        <div class="d-flex align-items-center mb-2">
                            <div class="avatar me-4">
                                <span class="avatar-initial rounded bg-label-success">
                                    <i class="bi bi-boxes fs-4"></i>
                                </span>
                            </div>
                            <h4 class="mb-0 fw-bold text-success" id="TotalGRNItemCount">0</h4>
                        </div>
                        <h6 class="mb-0 fw-normal">Total GRN Items</h6>
                        <p class="mb-0">
                            <small class="text-body-secondary">All received items</small>
                        </p>
                    </div>
                    <div class="bottom-border bg-success"></div>
                </div>
            </div>*@

            <!-- QC Pending Card -->
            <div class="col-sm-6 col-lg-4">
                <div id="QCCountCard" class="card card-border-shadow-warning h-100 border-0 position-relative overflow-hidden hover-shadow" style="cursor: pointer;">
                    <div class="card-body">
                        <div class="d-flex align-items-center mb-2">
                            <div class="avatar me-4">
                                <span class="avatar-initial rounded bg-label-warning">
                                    <i class="bi bi-clock-history fs-4"></i>
                                </span>
                            </div>
                            <h4 class="mb-0 fw-bold text-warning" id="QCAssignedCount">0</h4>
                        </div>
                        <h6 class="mb-0 fw-normal">QC Pending</h6>
                        <p class="mb-0">
                            <small class="text-body-secondary">Items awaiting quality check</small>
                        </p>
                    </div>
                    <div class="bottom-border bg-warning"></div>
                </div>
            </div>

            <!-- Upcoming Items Card -->
            <div class="col-sm-6 col-lg-4">
                <div id="UpcomingItemCard" class="card card-border-shadow-info h-100 border-0 position-relative overflow-hidden hover-shadow" style="cursor: pointer;">
                    <div class="card-body">
                        <div class="d-flex align-items-center mb-2">
                            <div class="avatar me-4">
                                <span class="avatar-initial rounded bg-label-info">
                                    <i class="bi bi-hourglass fs-4"></i>
                                </span>
                            </div>
                            <h4 class="mb-0 fw-bold text-info" id="UpcomingItemCount">0</h4>
                        </div>
                        <h6 class="mb-0 fw-normal">Upcoming Items</h6>
                        <p class="mb-0">
                            <small class="text-body-secondary">Upcoming Items from PO</small>
                        </p>
                    </div>
                    <div class="bottom-border bg-info"></div>
                </div>
            </div>
        </div>
        <!-- END KPI CARDS SECTION -->
        <!-- Date Range Heading -->
        <div class="row mb-3">
            <div class="col-12 text-center">
                <h5 class="fw-bold text-primary">
                    <i class="bi bi-calendar-range me-2"></i>
                    <span id="selectedRangeHeading">Showing Data: All Time</span>
                </h5>
                <hr>
            </div>
        </div>

        <!-- CHARTS SECTION -->
        <div class="row g-4">
            <!-- Quality Check Status Bar Chart -->
            <div class="col-lg-6">
                <div class="card shadow-sm border-0 rounded-4 p-3 chart-card">
                    <h6 class="fw-bold mb-3 text-success">
                        <i class="bi bi-bar-chart-fill me-2"></i>Quality Check Status
                    </h6>
                    <div id="statusChart" style="height: 350px; min-width: 280px;"></div>
                </div>
            </div>

            <!-- GRN Trends Chart -->
            <div class="col-lg-6">
                <div class="card shadow-sm border-0 rounded-4 p-3 chart-card">
                    <h6 class="fw-bold mb-3 text-primary">
                        <i class="bi bi-graph-up me-2"></i>GRN Trends Over Time
                    </h6>
                    <div id="trendChart" style="height: 350px; min-width: 280px;"></div>
                </div>
            </div>
        </div>
        <!-- END CHARTS SECTION -->
    </div>

    <!-- REUSABLE MODAL FOR DETAILED VIEWS -->
    <div class="modal fade" id="itemsModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-xl ">
            <div class="modal-content shadow-lg rounded-3">
                <!-- Modal Header -->
                <div class="modal-header bg-primary d-flex justify-content-center align-items-center rounded-top p-3">
                    <h5 class="modal-title fw-bold text-white mb-0 fs-5" id="itemsModalLabel"></h5>
                    <button type="button" class="btn-close btn-close-white position-absolute end-0 me-3"
                            data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <!-- ===== DATE PICKER SECTION ===== -->
                <div class="modal-date-picker-container w-10 mt-5">
                    <div class="row align-items-center g-2">
                        <div class="col-md-3 ms-5">
                            <div class="input-group">
                                <span class="input-group-text bg-primary text-white">
                                    <i class="bi bi-calendar-date"></i>
                                </span>
                                <input type="text" id="modalDatePicker"
                                       class="form-control"
                                       placeholder="Select date range"
                                       readonly />
                            </div>
                        </div>

                        @*<div class="col-md-8 d-flex justify-content-end align-items-center"
                             id="modalExportContainer">
                        </div>*@
                    </div>
                </div>
                <!-- ===== END DATE PICKER ===== -->
                <!-- Modal Body -->
                <div class="modal-body" id="modalContent"></div>
            </div>
        </div>
    </div>

    <style>
        button.dt-button.processing,
        div.dt-button.processing {
            pointer-events: auto !important;
            opacity: 1 !important;
            background: none !important;
        }

            button.dt-button.processing:after {
                content: none !important;
            }
    </style>

    <script>
        // GLOBAL VARIABLES
        let dataTable;
        let selectedStartDate = '';
        let selectedEndDate = '';
        let statusChart, trendChart;
        let tableStartDate = null;
        let tableEndDate = null;
        let modalDataTable = null;
        let currentModalUrl = '';
        let currentModalTitle = '';

        // === Global Highcharts Theme ===
        Highcharts.setOptions({
            chart: {
                style: {
                    fontFamily: 'Poppins, sans-serif'
                }
            },
            colors: ['#6EC6FF', '#FFD54F', '#A5D6A7', '#F48FB1', '#90CAF9', '#CE93D8'],
            title: { style: { color: '#333', fontWeight: 'bold' } },
            xAxis: {
                lineColor: '#e0e0e0',
                labels: { style: { color: '#666', fontSize: '12px' } }
            },
            yAxis: {
                gridLineColor: '#f0f0f0',
                labels: { style: { color: '#666', fontSize: '12px' } }
            },
            tooltip: {
                borderColor: '#ddd',
                borderRadius: 10,
                backgroundColor: 'rgba(255,255,255,0.95)',
                style: { color: '#333', fontSize: '13px' },
                shadow: { color: 'rgba(0,0,0,0.05)', offsetX: 2, offsetY: 2, opacity: 0.5, width: 1 }
            },
            plotOptions: {
                series: { animation: { duration: 1000 } }
            }
        });

        $(document).ready(function () {


            $(document).on('click', '.view-grn-items', function () {

                const grnCode = $(this).data('grncode');

                $("#itemsModal").modal("show");
                $("#itemsModalLabel").text("GRN Items - " + grnCode);

                $("#modalContent").html(`
        <div class="text-center py-5">
            <div class="spinner-border text-primary"></div>
            <p class="mt-2">Loading GRN Items...</p>
        </div>
    `);
    $.get('@Url.Action("GetGRNItemsByGRNCodePartialRHK","GRN")',
      { grnCode: grnCode },
      function (html) {
          $("#modalContent").html(html);
          initializeModalDataTable("GRN Items - " + grnCode);
      })
 .fail(function (xhr) {
      alert("ERROR: " + xhr.status);
 });

            });





            // Initialize main dashboard date range picker
            initDateRangePicker();

            // Initialize modal date picker
            initModalDatePicker();

            // Set up click event handlers for KPI cards
            $("#TotalCountCard").click(() => openModalWithPartial("/GRN/GetGRNListPartialRHK", "All GRNs"));
            $("#GRNItemsCountCard").click(() => openModalWithPartial("/GRN/GetGRNItemsPartialRHK", "GRN Items"));
            $("#QCCountCard").click(() => openModalWithPartial("/GRN/GetPendingItemsPartialRHK", "Pending QC Items"));
            $("#UpcomingItemCard").click(() => openModalWithPartial("/GRN/GetUpcomingItemPartialRHK", "Upcoming Items"));

            // Load initial data
            loadKPIData(selectedStartDate, selectedEndDate);
            loadStatusData(selectedStartDate, selectedEndDate);
            loadTrendData(selectedStartDate, selectedEndDate);
        });

        // Initialize modal date picker
        function initModalDatePicker() {
            $('#modalDatePicker').daterangepicker({
                autoUpdateInput: false,
                opens: "center",
                drops: "down",
                locale: {
                    format: "DD-MM-YYYY",
                    cancelLabel: "Clear"
                },
                ranges: {
                    'Today': [moment(), moment()],
                    'Last 7 Days': [moment().subtract(6, 'days'), moment()],
                    'Last 1 Month': [moment().subtract(1, 'month'), moment()],
                    'Last 3 Months': [moment().subtract(3, 'month'), moment()],
                    'Last 1 Year': [moment().subtract(1, 'year'), moment()]
                }
            }, function (start, end) {
                $('#modalDatePicker').val(start.format("DD-MM-YYYY") + " - " + end.format("DD-MM-YYYY"));
                // Reload modal content with new dates
                if (currentModalUrl) {
                    reloadModalContent(currentModalUrl, currentModalTitle, start.format("YYYY-MM-DD"), end.format("YYYY-MM-DD"));
                }
            });

            $('#modalDatePicker').on("cancel.daterangepicker", function () {
                $(this).val("");
                // Reload modal content without date filter
                if (currentModalUrl) {
                    reloadModalContent(currentModalUrl, currentModalTitle, null, null);
                }
            });
        }

        function initDateRangePicker() {
            const start = moment().startOf('year');
            const end = moment().endOf('year');

            function updateDashboard(start, end) {
                selectedStartDate = start.format('YYYY-MM-DD');
                selectedEndDate = end.format('YYYY-MM-DD');

                $('#dateFilterBtn span').html(start.format('MMMM D, YYYY') + ' - ' + end.format('MMMM D, YYYY'));
                $('#selectedRangeHeading').text(
                    'Showing Data: ' + start.format('MMM D, YYYY') + ' - ' + end.format('MMM D, YYYY')
                );
                loadKPIData(selectedStartDate, selectedEndDate);
                loadStatusData(selectedStartDate, selectedEndDate);
                loadTrendData(selectedStartDate, selectedEndDate);
            }

            $('#dateFilterBtn').daterangepicker({
                startDate: start,
                endDate: end,
                locale: {
                    cancelLabel: 'Clear',
                    format: 'DD/MM/YYYY'
                },
                ranges: {
                    'Today': [moment(), moment()],
                    'Last 7 Days': [moment().subtract(6, 'days'), moment()],
                    'Last 1 Month': [moment().subtract(1, 'months').startOf('day'), moment()],
                    'Last 3 Months': [moment().subtract(3, 'months').startOf('day'), moment()],
                    'Last 1 Year': [moment().subtract(12, 'months').startOf('day'), moment()]
                },
                alwaysShowCalendars: true,
                autoApply: false
            }, function (start, end) {
                updateDashboard(start, end);
            });

            $('#dateFilterBtn').on('cancel.daterangepicker', function (ev, picker) {
                selectedStartDate = "";
                selectedEndDate = "";
                $('#dateFilterBtn span').html('All Data');
                $('#selectedRangeHeading').text('Showing Data: All Time');
                loadKPIData(null, null);
                loadStatusData(null, null);
                loadTrendData(null, null);
            });

            updateDashboard(start, end);
        }

        function loadKPIData(startDate, endDate) {
            $("#TotalGRNCount").html('<span class="spinner-border spinner-border-sm"></span>');
            $("#TotalGRNItemCount").html('<span class="spinner-border spinner-border-sm"></span>');
            $("#QCAssignedCount").html('<span class="spinner-border spinner-border-sm"></span>');
            $("#UpcomingItemCount").html('<span class="spinner-border spinner-border-sm"></span>');

            $.getJSON("/GRN/GetTotalGRNRHK", { startDate: startDate, endDate: endDate }, function (data) {
                $("#TotalGRNCount").text(data.count || 0);
            }).fail(function () {
                $("#TotalGRNCount").text("Error");
            });

            $.getJSON("/GRN/GetTotalGRNItemRHK", { startDate: startDate, endDate: endDate }, function (data) {
                $("#TotalGRNItemCount").text(data.count || 0);
            }).fail(function () {
                $("#TotalGRNItemCount").text("Error");
            });

            // FIXED: Using PendingCountRHK instead of QCAssignedCountRHK
            $.getJSON("/GRN/GetPendingCountRHK", { startDate: startDate, endDate: endDate }, function (data) {
                $("#QCAssignedCount").text(data.count || 0);
            }).fail(function () {
                $("#QCAssignedCount").text("Error");
            });

            $.getJSON("/GRN/GetUpcomingItemCountRHK", { startDate: startDate, endDate: endDate }, function (data) {
                $("#UpcomingItemCount").text(data.count || 0);
            }).fail(function () {
                $("#UpcomingItemCount").text("Error");
            });
        }

        function loadStatusData(startDate, endDate) {
            $.getJSON("/GRN/GetApproveCountRHK", { startDate: startDate, endDate: endDate }, function (res1) {
                $.getJSON("/GRN/GetRejectedGRNCountRHK", { startDate: startDate, endDate: endDate }, function (res2) {
                    $.getJSON("/GRN/GetPendingCountRHK", { startDate: startDate, endDate: endDate }, function (res3) {
                        const approvedCount = res1.count || 0;
                        const rejectedCount = res2.count || 0;
                        const pendingCount = res3.count || 0;
                        createStatusChart(approvedCount, rejectedCount, pendingCount);
                    }).fail(function () {
                        createStatusChart(0, 0, 0);
                    });
                }).fail(function () {
                    createStatusChart(0, 0, 0);
                });
            }).fail(function () {
                createStatusChart(0, 0, 0);
            });
        }

        function createStatusChart(approvedCount, rejectedCount, pendingCount) {
            if (statusChart) {
                statusChart.destroy();
            }

            statusChart = Highcharts.chart('statusChart', {
                chart: {
                    type: 'bar',
                    backgroundColor: 'transparent',
                    height: 320,
                    animation: { duration: 700 }
                },
                title: {
                    text: 'Confirm, Non-Confirm & Pending Items',
                    style: {
                        fontSize: '18px',
                        fontWeight: '600',
                        color: '#2c3e50'
                    }
                },
                xAxis: {
                    categories: ['Confirm', 'Non Confirm', 'Pending'],
                    labels: {
                        style: {
                            fontSize: '14px',
                            fontWeight: '600',
                            color: '#2c3e50'
                        }
                    }
                },
                yAxis: {
                    title: { text: '' },
                    min: 0,
                    allowDecimals: false,
                    gridLineColor: '#e5e5e5',
                    labels: {
                        formatter: function () {
                            return Highcharts.numberFormat(this.value, 0);
                        },
                        style: {
                            color: '#555',
                            fontWeight: '500'
                        }
                    }
                },
                tooltip: {
                    backgroundColor: '#fff',
                    borderColor: '#ccc',
                    borderRadius: 4,
                    shadow: true,
                    useHTML: true,
                    pointFormatter: function () {
                        return `<b>${this.name}:</b> ${Highcharts.numberFormat(this.y, 0)} items`;
                    }
                },
                plotOptions: {
                    bar: {
                        borderRadius: 6,
                        pointPadding: 0.2,
                        groupPadding: 0.15,
                        dataLabels: {
                            enabled: true,
                            style: {
                                fontWeight: '600',
                                color: '#000',
                                textOutline: 'none',
                                fontSize: '13px'
                            }
                        },
                        states: {
                            hover: {
                                brightness: 0.1
                            }
                        },
                        cursor: 'pointer',
                        point: {
                            events: {
                                click: function () {
                                    if (this.category === 'Confirm') {
                                        openModalWithPartial("/GRN/GetApprovedItemsPartialRHK", "Approved Items");
                                    } else if (this.category === 'Non Confirm') {
                                        openModalWithPartial("/GRN/GetRejectedItemsPartialRHK", "Rejected Items");
                                    } else {
                                        openModalWithPartial("/GRN/GetPendingItemsPartialRHK", "Pending Items");
                                    }
                                }
                            }
                        }
                    }
                },
                legend: { enabled: false },
                credits: { enabled: false },
                series: [{
                    name: 'Count',
                    data: [
                        { name: 'Confirm', y: approvedCount, color: '#28a745' },
                        { name: 'Non Confirm', y: rejectedCount, color: '#dc3545' },
                        { name: 'Pending', y: pendingCount, color: '#fd7e14' }
                    ]
                }]
            });
        }

        function loadTrendData(startDate, endDate) {
            $.getJSON("/GRN/GetGRNTrendsRHK", { startdate: startDate, enddate: endDate }, function (res) {
                if (trendChart) {
                    trendChart.destroy();
                }

                trendChart = Highcharts.chart('trendChart', {
                    chart: {
                        type: 'spline',
                        backgroundColor: 'transparent',
                        height: 300
                    },
                    title: {
                        text: 'Monthly GRN Trends',
                        style: {
                            fontSize: '16px',
                            fontWeight: 'bold',
                            color: '#333'
                        }
                    },
                    xAxis: {
                        categories: res.months,
                        title: { text: 'Month' }
                    },
                    yAxis: {
                        min: 0,
                        title: {
                            text: 'Number of GRNs'
                        },
                        labels: {
                            formatter: function () {
                                return Highcharts.numberFormat(this.value, 0);
                            }
                        },
                        allowDecimals: false
                    },
                    tooltip: {
                        formatter: function () {
                            return `<b>${this.x}</b><br/>GRNs: <b>${this.y}</b>`;
                        }
                    },
                    plotOptions: {
                        spline: {
                            dataLabels: {
                                enabled: false
                            }
                        }
                    },
                    series: [{
                        name: 'GRNs',
                        data: res.counts,
                        color: '#4361ee'
                    }],
                    credits: { enabled: false }
                });
            }).fail(function () {
                if (trendChart) {
                    trendChart.destroy();
                }

                trendChart = Highcharts.chart('trendChart', {
                    chart: {
                        type: 'spline',
                        backgroundColor: 'transparent'
                    },
                    title: { text: 'Monthly GRN Trends' },
                    yAxis: {
                        allowDecimals: false
                    },
                    series: [{ name: 'GRNs', data: [] }],
                    credits: { enabled: false }
                });
            });
        }

        function openModalWithPartial(url, title) {
            currentModalUrl = url;
            currentModalTitle = title;

            $("#itemsModal").modal("show");
            $("#itemsModalLabel").text(title);
            $("#modalContent").html('<div class="spinner-container text-center py-5"><div class="spinner-border text-primary" role="status"></div><p class="mt-2">Loading...</p></div>');

            // Set initial date in modal picker
            if (selectedStartDate && selectedEndDate) {
                const start = moment(selectedStartDate).format("DD-MM-YYYY");
                const end = moment(selectedEndDate).format("DD-MM-YYYY");
                $('#modalDatePicker').val(start + " - " + end);
            } else {
                $('#modalDatePicker').val("");
            }

            const fullUrl = `${url}?startDate=${selectedStartDate || ''}&endDate=${selectedEndDate || ''}`;

            $.get(fullUrl, function (html) {
                $("#modalContent").html(html);
                initializeModalDataTable(title);
            }).fail(function () {
                $("#modalContent").html(
                    '<div class="alert alert-danger text-center mt-3">Failed to load data. Please try again.</div>'
                );
            });
        }

        function reloadModalContent(url, title, startDate, endDate) {
            $("#modalContent").html('<div class="spinner-container text-center py-5"><div class="spinner-border text-primary" role="status"></div><p class="mt-2">Loading...</p></div>');

            const fullUrl = `${url}?startDate=${startDate || ''}&endDate=${endDate || ''}`;

            $.get(fullUrl, function (html) {
                $("#modalContent").html(html);
                initializeModalDataTable(title);
            }).fail(function () {
                $("#modalContent").html(
                    '<div class="alert alert-danger text-center mt-3">Failed to load data. Please try again.</div>'
                );
            });
        }

        function initializeModalDataTable(title) {
            let $table = $("#ListTable");

            // Destroy existing DataTable if it exists
            if ($.fn.DataTable.isDataTable($table)) {
                modalDataTable.destroy();
            }

            // Check if table has data
            if ($table.find("tbody tr").length > 0 &&
                !$table.find("tbody tr td").hasClass("text-center")) {

                modalDataTable = $table.DataTable({
                    pageLength: 10,
                    paging: true,
                    ordering: false,
                    searching: true,
                    dom: '<"row mb-3"<"col-md-6 d-flex gap-2"B><"col-md-6 d-flex justify-content-end"f>>' +
                        '<"table-responsive"t>' +
                        '<"row mt-3"<"col-md-6"i><"col-md-6 d-flex justify-content-end"p>>',
                    buttons: [
                        {
                            extend: 'print',
                            text: '<i class="bi bi-printer-fill text-dark fs-5"></i>',
                            className: 'btn btn-sm btn-outline-dark',
                            title: `${title}`,
                            messageTop: function () {
                                return '<h3 style="text-align:center">Generated Date: ' +
                                    new Date().toLocaleDateString('en-GB') + '</h3>';
                            },
                            action: function (e, dt, button, config) {
                                if ($('#ListTable tbody input.row-select:checked').length === 0) {
                                    showExportToast();
                                    return;
                                }
                                $.fn.dataTable.ext.buttons.print.action.call(this, e, dt, button, config);
                            },
                            exportOptions: {
                                rows: function (idx, data, node) {
                                    return $(node).find('.row-select').prop('checked');
                                },
                                columns: ':visible:not(:first-child)',
                                format: {
                                    body: function (data, row, column, node) {
                                        if (column === 1)
                                            return $('#ListTable tbody input.row-select:checked')
                                                .index($(node).closest('tr').find('.row-select')) + 1;

                                        return typeof data === 'string'
                                            ? data.replace(/<[^>]*>/g, '').trim()
                                            : data;
                                    }
                                }
                            },
                            customize: function (win) {
                                var $body = $(win.document.body);
                                $body.append(`
                                        <style>
                                            thead th {
                                                background-color: black !important;
                                                color: white !important;
                                                text-align: center !important;
                                                -webkit-print-color-adjust: exact !important;
                                                print-color-adjust: exact !important;
                                            }
                                            table {
                                                border-collapse: collapse !important;
                                                width: 100% !important;
                                            }
                                            td, th {
                                                border: 1px solid #000 !important;
                                                padding: 6px !important;
                                                text-align: center !important;
                                            }
                                        </style>
                                    `);
                                $body.find('h1').css('text-align', 'center');
                                $body.find('table')
                                    .addClass('table table-bordered table-striped')
                                    .css('width', '100%');
                                $body.css('font-size', '12pt');
                            }
                        },
                        {
                            extend: 'pdfHtml5',
                            text: '<i class="bi bi-file-earmark-pdf text-danger fs-5"></i>',
                            className: 'btn btn-sm btn-outline-danger',
                            title: `${title}`,
                            orientation: 'landscape',
                            pagesize: 'A4',
                            customize: function (doc) {
                                doc.content.splice(1, 0, {
                                    text: 'Generated Date: ' + new Date().toLocaleDateString('en-GB'),
                                    alignment: 'center',
                                    margin: [0, 0, 0, 12]
                                });

                                var table = doc.content[doc.content.length - 1].table;
                                table.widths = new Array(table.body[0].length).fill('*');
                                doc.content[doc.content.length - 1].alignment = 'center';

                                doc.styles.tableHeader = { fillColor: '#000000', color: 'white', alignment: 'center' };

                                var objLayout = {};
                                objLayout['hLineWidth'] = function () { return 1; };
                                objLayout['vLineWidth'] = function () { return 1; };
                                objLayout['hLineColor'] = function () { return '#000'; };
                                objLayout['vLineColor'] = function () { return '#000'; };
                                objLayout['paddingLeft'] = function () { return 4; };
                                objLayout['paddingRight'] = function () { return 4; };
                                doc.content[doc.content.length - 1].layout = objLayout;

                                var tableBody = doc.content[doc.content.length - 1].table.body;
                                tableBody.forEach(function (row) {
                                    row.forEach(function (cell) {
                                        cell.alignment = 'center';
                                    });
                                });
                            },
                            action: function (e, dt, button, config) {
                                if ($('#ListTable tbody input.row-select:checked').length === 0) {
                                    showExportToast();
                                    return;
                                }
                                $.fn.dataTable.ext.buttons.pdfHtml5.action.call(this, e, dt, button, config);
                            },
                            exportOptions: {
                                rows: function (idx, data, node) {
                                    return $(node).find('.row-select').prop('checked');
                                },
                                columns: ':visible:not(:first-child)',
                                format: {
                                    body: function (data, row, column, node) {
                                        if (column === 1)
                                            return $('#ListTable tbody input.row-select:checked')
                                                .index($(node).closest('tr').find('.row-select')) + 1;
                                        return typeof data === 'string'
                                            ? data.replace(/<[^>]*>/g, '').trim()
                                            : data;
                                    }
                                }
                            }
                        },
                        {
                            extend: 'excelHtml5',
                            text: '<i class="bi bi-file-earmark-excel text-success fs-5"></i>',
                            className: 'btn btn-sm btn-outline-success',
                            title: `${title}`,
                            messageTop: 'Generated Date: ' + moment().format('DD/MM/YYYY'),
                            action: function (e, dt, button, config) {
                                if ($('#ListTable tbody input.row-select:checked').length === 0) {
                                    showExportToast();
                                    return;
                                }
                                $.fn.dataTable.ext.buttons.excelHtml5.action.call(this, e, dt, button, config);
                            },
                            exportOptions: {
                                rows: function (idx, data, node) {
                                    return $(node).find('.row-select').prop('checked');
                                },
                                columns: ':visible:not(:first-child)',
                                format: {
                                    body: function (data, row, column, node) {
                                        if (column === 1)
                                            return $('#ListTable tbody input.row-select:checked')
                                                .index($(node).closest('tr').find('.row-select')) + 1;
                                        return typeof data === 'string'
                                            ? data.replace(/<[^>]*>/g, '').trim()
                                            : data;
                                    }
                                }
                            },
                            customize: function (xlsx) {
                                const sheet = xlsx.xl.worksheets['sheet1.xml'];
                                $('row:first c', sheet).attr('s', '51');
                                $('row:eq(1) c', sheet).attr('s', '51');
                            }
                        },
                        {
                            extend: 'csvHtml5',
                            text: '<i class="bi bi-filetype-csv text-primary fs-5"></i>',
                            className: 'btn btn-sm btn-outline-primary',
                            title: `${title}`,
                            action: function (e, dt, button, config) {
                                if ($('#ListTable tbody input.row-select:checked').length === 0) {
                                    showExportToast();
                                    return;
                                }
                                $.fn.dataTable.ext.buttons.csvHtml5.action.call(this, e, dt, button, config);
                            },
                            exportOptions: {
                                rows: function (idx, data, node) {
                                    return $(node).find('.row-select').prop('checked');
                                },
                                columns: ':visible:not(:first-child)',
                                format: {
                                    body: function (data, row, column, node) {
                                        if (column === 1)
                                            return $('#ListTable tbody input.row-select:checked')
                                                .index($(node).closest('tr').find('.row-select')) + 1;
                                        return typeof data === 'string'
                                            ? data.replace(/<[^>]*>/g, '').trim()
                                            : data;
                                    }
                                }
                            }
                        }
                    ]
                });

                // Checkbox handling
                $('#selectAll').off('change').on('change', function () {
                    $('#ListTable tbody .row-select').prop('checked', $(this).prop('checked'));
                });

                $('#ListTable').off('change', '.row-select').on('change', '.row-select', function () {
                    let total = $('#ListTable tbody .row-select').length;
                    let checked = $('#ListTable tbody .row-select:checked').length;
                    $('#selectAll').prop('checked', total === checked);
                });
            }
        }

        // Toastr configuration
        toastr.options = {
            closeButton: true,
            progressBar: true,
            newestOnTop: true,
            positionClass: "toast-top-right",
            preventDuplicates: true,
            timeOut: 3000,
            extendedTimeOut: 1000,
            showDuration: 300,
            hideDuration: 300,
            showMethod: "slideDown",
            hideMethod: "fadeOut"
        };

        function showExportToast() {
            toastr.warning("Please select at least one row before exporting.");
        }
    </script>
</body>
</html>